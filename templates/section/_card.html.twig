<div class="card">
	<div class="blog-card-img-wrap">
		{% if section.images is not empty %}
			<img src="{{ section.images[0] }}" alt="{{ section.title }}" onerror="this.parentElement.innerHTML='💃'">
		{% else %}
			💃
		{% endif %}
	</div>
	<div class="card-body">
		<div class="card-tag">{{ section.age }}</div>
		<h3>{{ section.title }}</h3>
		<p class="text-muted mt-8" style="font-size:.85rem">{{ section.desc }}</p>
		<div style="margin-top:12px;font-size:.8rem;color:var(--c-muted)">🕐 {{ section.horaire }}</div>
		<a href="{{ path('app_sections_show', {slug: section.slug}) }}" style="color:var(--c-red);font-size:.82rem;text-decoration:none;font-weight:600;display:block;margin-top:10px">Détails →</a>
	</div>
</div>