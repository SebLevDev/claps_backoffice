<a class="circle-grid-item" href="{{ section.slug == 'amiclap' ? path('app_friends') : path('app_sections_show', {slug: section.slug}) }}">
	<div class="circle-grid-photo">
		<div class="circle-grid-mask">
			{% if section.images is not empty %}
				<img src="{{ section.images[0] }}" alt="{{ section.title }}" onerror="this.outerHTML='💃'">
			{% else %}
				💃
			{% endif %}
		</div>
		<span class="circle-grid-tag">{{ section.title }}</span>
	</div>
	<p class="circle-grid-meta">{{ section.age }}</p>
</a>
