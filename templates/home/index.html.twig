{% extends 'layout.html.twig' %}

{% block banner_title %}Accueil{% endblock %}
{% block title %}Clap'Sabots – Cours de danse traditionnelle à Braine-l'Alleud{% endblock %}
{% block meta_description %}Ensemble de danse, musique et chant traditionnels fondé en 1977 à Braine-l'Alleud. Cours pour tous les âges, spectacles, stages avec chorégraphe et festivals de folklore en Belgique et à l'étranger.{% endblock %}

{% block main %}
    <!-- ══════════ HOME ══════════ -->
    <div class="page active" id="page-home">
        {% include 'home/_hero.html.twig' %}
        {% include 'section/_strip.html.twig' %}
        {% include 'home/_activities.html.twig' %}
        {% include 'home/_agenda.html.twig' %}
        {% include 'home/_blog.html.twig' %}

        <!-- CTA (parallax : photo fixe + voile rouge, façon bande "Championship Dance" du template :
             diagonale à l'entrée, dents arrondies à la sortie) -->
        <section class="parallax-section parallax-red diagonal-top-rev" style="background-image:url('{{ asset('images/clapsabots/enfants-tambourins.jpg') }}')">
            <div class="container text-center" style="max-width:580px;margin:auto">
                <p class="hero-eyebrow">Rejoignez-nous</p>
                <h2 class="section-title">Prêt(e) à danser ?</h2>
                <p style="margin:16px 0 32px">Les cours reprennent chaque automne. Inscriptions ouvertes toute l'année sous réserve de places disponibles.</p>
                <div style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap">
                    <a href="{{ path('app_contact') }}" class="btn btn-white">Nous contacter</a>
                    <a href="{{ path('app_sections_list') }}" class="btn btn-outline">Voir les sections</a>
                </div>
            </div>
        </section>
    </div>

    <!-- L'espace membre réel vit sous /profile, /video, /clothes, /documents, ... (voir templates/member/) -->
{% endblock %}
