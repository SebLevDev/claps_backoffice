{% extends 'layout.html.twig' %}

{% block banner_title %}Accueil{% endblock %}
{% block title %}Accueil{% endblock %}

{% block main %}
    <!-- ══════════ HOME ══════════ -->
    <div class="page active" id="page-home">
        {% include 'home/_hero.html.twig' %}
        {% include 'section/_strip.html.twig' %}
        {% include 'home/_activities.html.twig' %}
        {% include 'home/_agenda.html.twig' %}
        {% include 'home/_blog.html.twig' %}

        <!-- CTA -->
        <section class="section bg-red">
            <div class="container text-center" style="max-width:580px;margin:auto">
                <p class="hero-eyebrow" style="color:rgba(255,255,255,.7)!important">Rejoignez-nous</p>
                <h2 class="section-title" style="color:#fff">Prêt(e) à danser ?</h2>
                <p style="color:rgba(255,255,255,.75);margin:16px 0 32px">Les cours reprennent chaque automne. Inscriptions ouvertes toute l'année sous réserve de places disponibles.</p>
                <div style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap">
                    <a href="{{ path('app_contact') }}" class="btn" style="background:#fff;color:var(--c-red)">Nous contacter</a>
                    <a href="{{ path('app_sections_list') }}" class="btn btn-outline">Voir les sections</a>
                </div>
            </div>
        </section>
    </div>

