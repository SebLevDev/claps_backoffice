{% set fr_months = ['', 'jan', 'fév', 'mar', 'avr', 'mai', 'jun', 'juil', 'aoû', 'sep', 'oct', 'nov', 'déc'] %}
<!-- BLOG -->
<section class="section bg-warm">
	<div class="container">
		<div class="flex-between mb-32">
			<div><p class="hero-eyebrow">Actualités</p><h2 class="section-title">Dernières nouvelles</h2></div>
			<a href="{{ path('app_blog_list') }}" class="btn btn-outline btn-sm">Tout le blog</a>
		</div>
		<div class="grid-3">
			{% for article in blog_preview %}
			<a href="{{ path('app_blog_show', {slug: article.slug}) }}" class="card" style="text-decoration:none;color:inherit">
				<div class="blog-card-img-wrap">
					<img src="{{ article.img }}" alt="{{ article.title }}" onerror="this.parentElement.style.fontSize='3rem';this.parentElement.innerHTML='📰'">
				</div>
				<div class="card-body">
					<div class="card-tag">{{ article.tag }}</div>
					<h3>{{ article.title }}</h3>
					<p class="text-muted mt-8" style="font-size:.82rem">{{ article.resume }}</p>
					<p style="font-size:.75rem;color:var(--c-muted);margin-top:12px">🗓 {{ article.date|date('d') }} {{ fr_months[article.date|date('n')] }} {{ article.date|date('Y') }}</p>
				</div>
			</a>
			{% endfor %}
		</div>
	</div>
</section>