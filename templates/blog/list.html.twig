{% extends 'layout.html.twig' %}

{% set fr_months = ['', 'Jan', 'Fév', 'Mar', 'Avr', 'Mai', 'Jun', 'Jul', 'Aoû', 'Sep', 'Oct', 'Nov', 'Déc'] %}

{% block banner_title %}Blog{% endblock %}
{% block title %}Blog – Actualités{% endblock %}
{% block meta_description %}L'actualité de l'Ensemble Clap'Sabots : comptes-rendus de spectacles, festivals, voyages et vie du groupe.{% endblock %}

{% block main %}
<div class="page-banner">
    <div class="container">
        <p class="hero-eyebrow">Actualités</p>
        <h1 class="display">Blog</h1>
        <p class="lead" style="max-width:580px;margin-top:8px">Retours d'expérience, comptes-rendus de stages et de voyages, vie du groupe.</p>
    </div>
</div>

<section class="section">
    <div class="container">
        <div class="timeline mt-32">
            {% for article in articles %}
            <div class="timeline-item">
                <div class="timeline-marker">
                    <div class="timeline-dot"></div>
                    <div class="timeline-date-label">
                        <span class="timeline-day">{{ article.date|date('d') }}</span>
                        <span class="timeline-month">{{ fr_months[article.date|date('n')] }}<br>{{ article.date|date('Y') }}</span>
                    </div>
                </div>
                <a href="{{ path('app_blog_show', {slug: article.slug}) }}" class="timeline-card{{ article.img ? '' : ' no-image' }}" style="text-decoration:none;color:inherit">
                    {% if article.img %}
                        <img class="timeline-card-img" src="{{ article.img }}" alt="{{ article.title }}" onerror="this.closest('.timeline-card').classList.add('no-image');this.remove()">
                    {% endif %}
                    <div class="timeline-card-body">
                        <div class="card-tag">{{ article.tag }}</div>
                        <h3>{{ article.title }}</h3>
                        <p class="text-muted mt-8" style="font-size:.88rem">{{ article.resume }}</p>
                    </div>
                </a>
            </div>
            {% endfor %}
        </div>

        {% if totalPages > 1 %}
        <div class="pagination">
            {% if currentPage > 1 %}
                <a href="{{ path('app_blog_list', {page: currentPage - 1}) }}" class="pagination-btn">← Précédent</a>
            {% else %}
                <button class="pagination-btn" disabled>← Précédent</button>
            {% endif %}

            {% for i in 1..totalPages %}
                <a href="{{ path('app_blog_list', {page: i}) }}" class="pagination-btn {{ i == currentPage ? 'active' : '' }}">{{ i }}</a>
            {% endfor %}

            {% if currentPage < totalPages %}
                <a href="{{ path('app_blog_list', {page: currentPage + 1}) }}" class="pagination-btn">Suivant →</a>
            {% else %}
                <button class="pagination-btn" disabled>Suivant →</button>
            {% endif %}
        </div>
        {% endif %}
    </div>
</section>
{% endblock %}