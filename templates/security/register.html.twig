{% extends 'layout.html.twig' %}

{% block title %}Créer un compte – Clap'Sabots{% endblock %}

{% block main %}
<div class="page-banner" style="padding:48px 0 64px">
    <div class="container" style="max-width:440px">
        <p class="hero-eyebrow">Espace membre</p>
        <h1 class="display" style="font-size:2rem;margin-bottom:0">Créer un compte</h1>
    </div>
</div>

<section class="section" style="padding-top:48px">
    <div class="container auth-card">
        <div class="card">
            <div class="card-body">
                <div class="notice mb-24">ℹ️ {{ 'user.register.info'|trans }}</div>

                {{ form_start(form, {'attr': {'class': 'auth-form'}}) }}
                {{ form_widget(form) }}
                <button type="submit" class="btn btn-primary mt-8" style="width:100%;justify-content:center">{{ 'user.register.action'|trans }}</button>
                {{ form_end(form) }}
            </div>
        </div>

        <p class="text-center text-muted mt-24" style="font-size:.9rem">
            {{ 'user.register.alreadyRegistered'|trans }} <a href="{{ path('security_login') }}">{{ 'user.login.action'|trans }}</a>
        </p>
    </div>
</section>
{% endblock %}
