{# Pièces du costume et leurs pièces uniques (couturière / porteur), affiché dans l'onglet "Pièces uniques"
   des pages détail et édition d'un costume. Création rapide de pièces uniques via l'écran d'attribution. #}
{# @var costume \Infra\Symfony\Persistance\Doctrine\Entity\ClothesCostume #}
<div class="cs-stocks" data-url="{{ path('admin_dashboard_clothesAssignment_stock') }}" data-csrf="{{ csrf_token(constant('Infra\\EasyAdmin\\Controller\\ClothesAssignmentController::CSRF_TOKEN_ID')) }}">
    <p>
        <a class="btn btn-sm btn-outline-primary" href="{{ path('admin_dashboard_clothesAssignment_index', {costume: costume.id}) }}">
            <i class="fa fa-people-arrows"></i> Ouvrir l'attribution (matrice danseurs × pièces)
        </a>
    </p>

    {% for costumePiece in costume.clothesCostumePieces %}
        {% set piece = costumePiece.piece %}
        {% set stocks = piece.clothesPieceStocks %}
        {% set kept = stocks|filter(s => s.dressKeeper is not null)|length %}
        <div class="card mb-3">
            <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                    <strong>{{ piece.name }}</strong>
                    <span class="text-secondary small ms-1">{{ piece.code }}</span>
                    {% if costumePiece.isDefault %}<span class="badge text-bg-primary ms-1">obligatoire</span>{% endif %}
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="small text-secondary cs-count">{{ stocks|length }} pièce(s) unique(s) · {{ kept }} portée(s) · {{ stocks|length - kept }} en stock</span>
                    <button type="button" class="btn btn-sm btn-success cs-open">+ Créer des pièces</button>
                </div>
            </div>
            <div class="card-body py-2 cs-create" hidden>
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <label class="small" for="cs-quantity-{{ piece.id }}">Combien ?</label>
                    <input type="number" id="cs-quantity-{{ piece.id }}" class="form-control form-control-sm cs-quantity" min="1" max="50" value="1" style="width: 6rem">
                    <button type="button" class="btn btn-sm btn-primary cs-save" data-piece="{{ piece.id }}">Enregistrer</button>
                    <button type="button" class="btn btn-sm btn-link cs-cancel">Annuler</button>
                    <span class="small text-secondary">Les nouvelles pièces sont créées en stock, sans couturière : complétez-les dans l'attribution.</span>
                </div>
            </div>
            <table class="table table-sm mb-0">
                <thead>
                    <tr><th style="width: 6rem">#</th><th>Couleur(s)</th><th>Cousue par</th><th>Portée par</th></tr>
                </thead>
                <tbody>
                    {% for stock in stocks %}
                        <tr>
                            <td>{{ stock.id }}</td>
                            <td>
                                {% for color in stock.colors %}
                                    <span title="{{ color.name }}" style="display:inline-block;width:.8rem;height:.8rem;border-radius:50%;border:1px solid rgba(0,0,0,.25);vertical-align:middle;background:{{ color.code|default('transparent') }}"></span>
                                    <span class="small">{{ color.name }}</span>
                                {% endfor %}
                            </td>
                            <td>{{ stock.dressMaker ?? '—' }}</td>
                            <td>
                                {% if stock.dressKeeper %}
                                    {{ stock.dressKeeper }}
                                {% else %}
                                    <span class="badge text-bg-light">en stock</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr class="cs-empty"><td colspan="4" class="text-secondary">Aucune pièce unique.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <div class="alert alert-info">Ce costume n'a encore aucune pièce.</div>
    {% endfor %}
</div>

<script>
    (() => {
        const root = document.currentScript.previousElementSibling;
        const toggle = (card, open) => { card.querySelector('.cs-create').hidden = !open; };

        root.addEventListener('click', async (e) => {
            const card = e.target.closest('.card');
            if (e.target.closest('.cs-open')) toggle(card, true);
            if (e.target.closest('.cs-cancel')) toggle(card, false);

            const save = e.target.closest('.cs-save');
            if (!save) return;
            const quantity = Number(card.querySelector('.cs-quantity').value);
            if (!(quantity >= 1 && quantity <= 50)) return;

            save.disabled = true;
            try {
                const response = await fetch(root.dataset.url, {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json', 'X-CSRF-Token': root.dataset.csrf},
                    body: JSON.stringify({piece: Number(save.dataset.piece), quantity}),
                });
                if (!response.ok) throw new Error(response.status);
                const {ids} = await response.json();

                const tbody = card.querySelector('tbody');
                tbody.querySelector('.cs-empty')?.remove();
                for (const id of ids) {
                    const row = tbody.insertRow();
                    row.className = 'table-success';
                    row.insertCell().textContent = id;
                    row.insertCell();
                    row.insertCell().textContent = '—';
                    row.insertCell().innerHTML = '<span class="badge text-bg-light">en stock</span>';
                }
                const count = card.querySelector('.cs-count');
                const [total, kept] = (count.textContent.match(/\d+/g) ?? [0, 0]).map(Number);
                count.textContent = `${total + ids.length} pièce(s) unique(s) · ${kept} portée(s) · ${total + ids.length - kept} en stock`;
                toggle(card, false);
            } catch (error) {
                alert(`Erreur lors de la création des pièces (${error.message})`);
            } finally {
                save.disabled = false;
            }
        });
    })();
</script>
