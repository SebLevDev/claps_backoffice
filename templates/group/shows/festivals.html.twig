{% extends 'layout.html.twig' %}

{% block banner_title %}Festivals{% endblock %}
{% block title %}Festivals de folklore – Clap'Sabots{% endblock %}

{% block main %}
<div class="page-banner">
    <div class="container" style="max-width:820px">
        <p class="hero-eyebrow">Sur scène, ici et ailleurs</p>
        <h1 class="display">Festivals de folklore</h1>
        <p class="lead">Depuis 1982, Clap'Sabots représente le folklore belge dans les festivals de danses et musiques traditionnelles, en Belgique comme à l'étranger.</p>
    </div>
</div>
<img class="banner-photo" src="{{ asset('images/clapsabots/festivals-hero.jpg') }}" alt="L'Ensemble Clap'Sabots en festival">

<section class="section">
    <div class="container" style="max-width:820px">

        <div class="blog-content">
            <p>Membre des fédérations de danses et musiques traditionnelles (FWGDMP, DAPO), l'Ensemble est régulièrement invité dans des festivals nationaux — Brabant wallon en fête, Marcinelle, Saint-Ghislain… — et dans des festivals internationaux affiliés au CIOFF et à l'IOV, où il partage l'affiche avec des groupes du monde entier.</p>
            <p>À chaque rencontre, ce sont des échanges, des amitiés et des invitations réciproques qui se nouent.</p>
        </div>

        <hr class="divider-diagonal">

        <h2 class="section-title">Nos dernières participations</h2>
        <div class="mt-16">
            <div class="event-item">
                <div style="font-size:1.6rem;text-align:center">🇭🇺</div>
                <div><div class="event-title">Festival international de folklore de Sárvár (IOV)</div><div class="event-meta">Hongrie · 2010</div></div>
                <span class="event-type type-spectacle">Festival</span>
            </div>
            <div class="event-item">
                <div style="font-size:1.6rem;text-align:center">🇬🇷</div>
                <div><div class="event-title">Festival international d'Aigion</div><div class="event-meta">Grèce · 2007</div></div>
                <span class="event-type type-spectacle">Festival</span>
            </div>
            <div class="event-item">
                <div style="font-size:1.6rem;text-align:center">🇨🇿</div>
                <div><div class="event-title">Festival international de folklore de Šlapanice (IOV)</div><div class="event-meta">Tchéquie · 2006</div></div>
                <span class="event-type type-spectacle">Festival</span>
            </div>
            <div class="event-item">
                <div style="font-size:1.6rem;text-align:center">🇧🇪</div>
                <div><div class="event-title">Fête de Wallonie</div><div class="event-meta">Namur · 2008</div></div>
                <span class="event-type type-spectacle">Festival</span>
            </div>
        </div>

        <div class="flex gap-12 mt-24" style="flex-wrap:wrap">
            <a href="{{ path('app_references') }}" class="btn btn-primary">Toutes nos références</a>
            <a href="{{ path('app_trips') }}" class="btn btn-outline">Nos voyages & échanges</a>
        </div>

        <hr class="divider-diagonal">

        <h2 class="section-title">En images</h2>
        <div class="section-gallery mt-16">
            <div class="section-gallery-item"><img src="{{ asset('images/clapsabots/festivals-hero.jpg') }}" alt="Ronde en festival"></div>
            <div class="section-gallery-item"><img src="{{ asset('images/clapsabots/ensemble-swirl.jpg') }}" alt="Danse d'ensemble"></div>
            <div class="section-gallery-item"><img src="{{ asset('images/clapsabots/g-leaping.jpg') }}" alt="Danseurs en mouvement"></div>
            <div class="section-gallery-item"><img src="{{ asset('images/clapsabots/g-redstage.jpg') }}" alt="Sur scène, fond rouge"></div>
            <div class="section-gallery-item"><img src="{{ asset('images/clapsabots/echanges-polynesie.jpg') }}" alt="Répertoire international"></div>
            <div class="section-gallery-item"><img src="{{ asset('images/clapsabots/gala-scene.jpg') }}" alt="Le groupe au complet"></div>
        </div>

        <hr class="divider-diagonal">

        <div class="card" style="border-color:rgba(234,96,69,.2)">
            <div class="card-body">
                <h3>Inviter Clap'Sabots dans votre festival</h3>
                <p class="text-muted mt-8" style="font-size:.9rem">Organisateurs de festivals, en Belgique ou à l'étranger&nbsp;: écrivez-nous pour envisager une participation.</p>
                <a href="{{ path('app_contact') }}" class="btn btn-primary mt-16">Nous contacter</a>
            </div>
        </div>

    </div>
</section>
{% endblock %}
