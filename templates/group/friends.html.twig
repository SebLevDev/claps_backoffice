{% extends 'layout.html.twig' %}

{% block banner_title %}AmiClap{% endblock %}
{% block title %}L'AmiClap – Clap'Sabots{% endblock %}

{% block main %}
<div class="page-banner">
    <div class="container" style="max-width:700px">
        <p class="hero-eyebrow">Soutien</p>
        <h1 class="display">L'AmiClap</h1>
        <p class="lead">L'AmiClap est l'association des amis et soutiens de Clap'Sabots, qui permettent à l'ensemble de se développer et rayonner.</p>
    </div>
</div>

<section class="section">
    <div class="container" style="max-width:700px">
        <div class="icon-box-grid mt-32 mb-32">
            <div class="icon-box">
                <div class="icon-box-mark">✉️</div>
                <h3 style="font-size:.95rem">1. Contact</h3>
                <p>Écrivez-nous pour manifester votre intérêt.</p>
            </div>
            <div class="icon-box">
                <div class="icon-box-mark">💳</div>
                <h3 style="font-size:.95rem">2. Cotisation</h3>
                <p>Réglez votre adhésion annuelle à l'AmiClap.</p>
            </div>
            <div class="icon-box">
                <div class="icon-box-mark">🎉</div>
                <h3 style="font-size:.95rem">3. Bienvenue</h3>
                <p>Recevez la newsletter et suivez la vie du groupe.</p>
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <h3>Pourquoi adhérer ?</h3>
                <ul class="icon-list mt-16">
                    <li>Soutenir la création de nouveaux costumes</li>
                    <li>Aider à financer les voyages et stages</li>
                    <li>Participer à la vie associative</li>
                    <li>Recevoir la newsletter du groupe</li>
                </ul>
                <a href="mailto:contact@clapsabots.be" class="btn btn-primary mt-16">Devenir ami·e de Clap'Sabots</a>
            </div>
        </div>
    </div>
</section>
{% endblock %}
