{% extends 'layout.html.twig' %}

{% block banner_title %}Équipe{% endblock %}
{% block title %}Notre équipe – Clap'Sabots{% endblock %}

{% block main %}
<div class="page-banner">
    <div class="container" style="max-width:800px">
        <p class="hero-eyebrow">Le groupe</p>
        <h1 class="display">Notre équipe</h1>
        <p class="lead">Les personnes qui font vivre Clap'Sabots au quotidien, sur scène comme en coulisses.</p>
    </div>
</div>

<section class="section">
    <div class="container" style="max-width:800px">
        <h2 class="section-title">Organe d'administration</h2>
        <div class="mt-24" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:28px 32px">
            <div>
                <h3 style="font-size:1rem">Sébastien Lévêque</h3>
                <p class="text-muted" style="font-size:.85rem;margin-top:2px">Président</p>
            </div>
            <div>
                <h3 style="font-size:1rem">Caroline Folens</h3>
                <p class="text-muted" style="font-size:.85rem;margin-top:2px">Trésorière</p>
            </div>
            <div>
                <h3 style="font-size:1rem">Chloé Wauthoz</h3>
                <p class="text-muted" style="font-size:.85rem;margin-top:2px">Secrétaire</p>
            </div>
            <div>
                <h3 style="font-size:1rem">Nicole de Keghel</h3>
                <p class="text-muted" style="font-size:.85rem;margin-top:2px">Fondatrice & Directrice artistique</p>
            </div>
            <div>
                <h3 style="font-size:1rem">Claude Troosters</h3>
            </div>
            <div>
                <h3 style="font-size:1rem">Julie Ansion</h3>
            </div>
            <div>
                <h3 style="font-size:1rem">Anne-Catherine Wauthoz</h3>
            </div>
        </div>

        <hr class="divider-diagonal">

        <h2 class="section-title">Nos moniteurs</h2>
        <div class="mt-24" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:16px 32px">
            <div><h3 style="font-size:1rem">Anne-Catherine Wauthoz</h3></div>
            <div><h3 style="font-size:1rem">Chloé Wauthoz</h3></div>
            <div><h3 style="font-size:1rem">Claude Troosters</h3></div>
            <div><h3 style="font-size:1rem">Gaëlle Sansterre</h3></div>
            <div><h3 style="font-size:1rem">Julie Ansion</h3></div>
            <div><h3 style="font-size:1rem">Léa Gielis</h3></div>
            <div><h3 style="font-size:1rem">Lucie Gielis</h3></div>
            <div><h3 style="font-size:1rem">Lucie Van Liedekerke</h3></div>
            <div><h3 style="font-size:1rem">Margaux Vanlaer</h3></div>
            <div><h3 style="font-size:1rem">Nicole de Keghel</h3></div>
        </div>
    </div>
</section>
{% endblock %}
