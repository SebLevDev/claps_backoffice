{% extends 'layout.html.twig' %}

{% block banner_title %}Spectacles{% endblock %}
{% block title %}Spectacles & animations – Clap'Sabots{% endblock %}

{% block main %}
<div class="page-banner">
    <div class="container" style="max-width:900px">
        <p class="hero-eyebrow">Activités</p>
        <h1 class="display">Spectacles & animations</h1>
        <p class="lead">En tant que membre, participez à des galas, fêtes de village, animations scolaires et événements culturels tout au long de l'année.</p>
    </div>
</div>

<section class="section">
    <div class="container" style="max-width:900px">
        <div class="divider-icon" style="margin-top:0"><span class="divider-icon-mark">🎭</span></div>

        <div class="grid-2">
            <div class="card">
                <div class="card-img-placeholder">
                    <img src="{{ asset('images/clapsabots/scene-ensemble.jpg') }}" alt="Gala" onerror="this.parentElement.innerHTML='🎪'">
                </div>
                <div class="card-body">
                    <h3>Gala annuel</h3>
                    <p class="text-muted mt-8" style="font-size:.85rem">Le grand rendez-vous où toutes les sections se retrouvent sur scène.</p>
                </div>
            </div>
            <div class="card">
                <div class="card-img-placeholder">
                    <img src="{{ asset('images/clapsabots/couples-chapeaux.jpg') }}" alt="Fêtes locales" onerror="this.parentElement.innerHTML='🏘️'">
                </div>
                <div class="card-body">
                    <h3>Fêtes locales</h3>
                    <p class="text-muted mt-8" style="font-size:.85rem">Animations dans les communes, braderies, marchés.</p>
                </div>
            </div>
            <div class="card">
                <div class="card-img-placeholder">
                    <img src="{{ asset('images/clapsabots/enfants-tambourins.jpg') }}" alt="Animations scolaires" onerror="this.parentElement.innerHTML='🏫'">
                </div>
                <div class="card-body">
                    <h3>Animations scolaires</h3>
                    <p class="text-muted mt-8" style="font-size:.85rem">Initiation aux danses du monde pour les classes primaires.</p>
                </div>
            </div>
            <div class="card">
                <div class="card-img-placeholder">
                    <img src="{{ asset('images/clapsabots/couronnes-fleurs.jpg') }}" alt="Festivals" onerror="this.parentElement.innerHTML='🌍'">
                </div>
                <div class="card-body">
                    <h3>Festivals</h3>
                    <p class="text-muted mt-8" style="font-size:.85rem">Représentation dans des festivals nationaux et internationaux.</p>
                </div>
            </div>
        </div>
    </div>
</section>
<div class="scallop-edge scallop-dark"></div>
{% endblock %}
