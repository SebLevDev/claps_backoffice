{% extends 'layout.html.twig' %}

{% block banner_title %}Spectacles{% endblock %}
{% block title %}Spectacles & animations – Clap'Sabots{% endblock %}

{% block main %}
<section class="section">
    <div class="container" style="max-width:900px">
        <p class="hero-eyebrow">Activités</p>
        <h1 class="display">Spectacles & animations</h1>
        <p class="lead">En tant que membre, participez à des galas, fêtes de village, animations scolaires et événements culturels tout au long de l'année.</p>

        <div class="grid-2 mt-32">
            <div class="card">
                <div class="card-img-placeholder">
                    <img src="https://www.clapsabots.be/wp-content/uploads/2015/04/arton1878-300x200.jpg" alt="Gala" onerror="this.parentElement.innerHTML='🎪'">
                </div>
                <div class="card-body">
                    <h3>Gala annuel</h3>
                    <p class="text-muted mt-8" style="font-size:.85rem">Le grand rendez-vous où toutes les sections se retrouvent sur scène.</p>
                </div>
            </div>
            <div class="card">
                <div class="card-img-placeholder" style="background:#e8ddd4;font-size:3rem;height:200px">🏘️</div>
                <div class="card-body">
                    <h3>Fêtes locales</h3>
                    <p class="text-muted mt-8" style="font-size:.85rem">Animations dans les communes, braderies, marchés.</p>
                </div>
            </div>
            <div class="card">
                <div class="card-img-placeholder" style="background:#e8ddd4;font-size:3rem;height:200px">🏫</div>
                <div class="card-body">
                    <h3>Animations scolaires</h3>
                    <p class="text-muted mt-8" style="font-size:.85rem">Initiation aux danses du monde pour les classes primaires.</p>
                </div>
            </div>
            <div class="card">
                <div class="card-img-placeholder">
                    <img src="https://www.clapsabots.be/wp-content/uploads/2016/10/23_Clapsabots_14_000_Bulgarie-1024x621.jpg" alt="Festivals" onerror="this.parentElement.innerHTML='🌍'">
                </div>
                <div class="card-body">
                    <h3>Festivals</h3>
                    <p class="text-muted mt-8" style="font-size:.85rem">Représentation dans des festivals nationaux et internationaux.</p>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
