<nav>
    <a class="nav-logo" href="/">Clap'<span>Sabots</span></a>
    <button class="hamburger" onclick="toggleMenu()"><span></span><span></span><span></span></button>
    <ul class="nav-links" id="navLinks">
        <li><a href="/">Accueil</a></li>
        <li class="dropdown"><a href="#">Le Groupe</a>
            <div class="dropdown-menu">
                <a href="{{ path('app_history') }}">Histoire & Qui sommes-nous</a>
                <a href="{{ path('app_giants') }}">Nos géants</a>
                <a href="{{ path('app_references') }}">Références</a>
                <a href="{{ path('app_friends') }}">L'AmiClap</a>
            </div>
        </li>
        <li class="dropdown"><a href="#">Sections</a>
            <div class="dropdown-menu">
                <a href="{{ path('app_sections_list') }}">Toutes les sections</a>
                {% for section in nav_sections() %}
                    {% if section.slug %}
                        <a href="{{ path('app_sections_show', {slug: section.slug}) }}">{{ section.name }}{% if section.ageRange %} ({{ section.ageRange }}){% endif %}</a>
                    {% endif %}
                {% endfor %}
            </div>
        </li>
        <li class="dropdown"><a href="#">Activités</a>
            <div class="dropdown-menu">
                <a href="{{ path('app_shows') }}">Spectacles & animations</a>
                <a href="{{ path('app_workshops') }}">Stages avec chorégraphe</a>
                <a href="{{ path('app_trips') }}">Voyages & échanges culturels</a>
            </div>
        </li>
        <li><a href="{{ path('app_agenda_list') }}">Agenda</a></li>
        <li><a href="{{ path('app_medias') }}">Médias</a></li>
        <li><a href="{{ path('app_blog_list') }}">Blog</a></li>
        <li><a href="{{ path('app_contact') }}">Contact</a></li>
        {% if is_granted('ROLE_USER') %}
            <li><a href="{{ path('app_user_show') }}">Mon Espace</a></li>
            <li><a href="{{ path('security_logout') }}" style="background:#5c3d2e!important">Déconnexion</a></li>
        {% else %}
            <li><a href="{{ path('security_login') }}" id="btn-login">Connexion</a></li>
        {% endif %}
    </ul>
</nav>