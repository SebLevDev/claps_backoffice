<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ensemble Clap'Sabots – Danses Traditionnelles</title>
<link href="https://fonts.googleapis.com/css2?family=Lato:wght@400;700;900&family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">

<style>
    :root {
        /* Palette reprise du thème "Dance Studio" (cmsmasters) de l'ancien site clapsabots.be */
        --c-bg:       #fafafa;
        --c-surface:  #ffffff;
        --c-card:     #ffffff;
        --c-border:   #e9e9e9;
        --c-red:      #ea6045;
        --c-red-dk:   #d31a3e;
        --c-red-lt:   #fdece6;
        --c-brown:    #1c222f;
        --c-gold:     #868991;
        --c-text:     #262b33;
        --c-muted:    #868991;
        --c-white:    #ffffff;
        --r:          4px;
        --r-lg:       6px;
        --nav-h:      64px;
        --shadow:     0 2px 16px rgba(28,34,47,.08);
        --shadow-lg:  0 8px 32px rgba(28,34,47,.12);
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body { font-family: 'Roboto', sans-serif; background: var(--c-bg); color: var(--c-text); min-height: 100vh; font-size: 15px; line-height: 1.65; }

    /* ─── NAV ─── */
    nav {
        position: fixed; top: 0; left: 0; right: 0; z-index: 100;
        height: var(--nav-h);
        background: rgba(255,255,255,.96);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--c-border);
        box-shadow: 0 1px 8px rgba(28,34,47,.06);
        display: flex; align-items: center; padding: 0 24px;
    }
    .nav-logo { font-family:'Lato',sans-serif; font-weight:900; font-size:1.4rem; color:var(--c-brown); text-decoration:none; flex-shrink:0; letter-spacing:.02em; }
    .nav-logo span { color:var(--c-red); }
    .nav-links { display:flex; align-items:center; gap:2px; margin-left:auto; list-style:none; flex-wrap:wrap; }
    .nav-links a { position:relative; z-index:1; color:var(--c-muted); text-decoration:none; font-size:.8rem; font-weight:500; padding:6px 10px; transition:color .2s; letter-spacing:.03em; text-transform:uppercase; }
    .nav-links a:hover,.nav-links a.active { color:#fff; }
    .nav-links a:hover::before,.nav-links a.active::before {
        content:''; position:absolute; z-index:-1; inset:0 2px;
        background:var(--c-red); transform:skewX(-12deg);
    }
    .nav-links .dropdown-menu a:hover::before,.nav-links .dropdown-menu a.active::before { display:none; }
    .nav-links .dropdown-menu a:hover,.nav-links .dropdown-menu a.active { color:var(--c-red); background:var(--c-red-lt); }
    .nav-links .dropdown { position:relative; }
    .nav-links .dropdown>a::after { content:' ▾'; font-size:.65rem; }
    .dropdown-menu { display:none; position:absolute; top:100%; left:0; background:#fff; border:1px solid var(--c-border); border-radius:var(--r); min-width:210px; z-index:200; overflow:hidden; box-shadow:var(--shadow-lg); }
    .dropdown:hover .dropdown-menu { display:block; }
    .dropdown-menu a { display:block; padding:10px 16px; border-radius:0; text-transform:none; font-size:.82rem; }
    .nav-links .btn { margin-left:10px; padding:9px 18px; font-size:.78rem; }
    .nav-links .btn-dark::before { background:var(--c-brown); }
    .nav-links .btn-dark:hover::before { background:#11151d; }
    .hamburger { display:none; background:none; border:none; cursor:pointer; padding:8px; margin-left:auto; }
    .hamburger span { display:block; width:22px; height:2px; background:var(--c-red); margin:5px 0; border-radius:2px; transition:.3s; }
    @media(max-width:860px) {
        .hamburger{display:block}
        .nav-links{display:none;position:fixed;top:var(--nav-h);left:0;right:0;background:#fff;flex-direction:column;padding:16px;gap:4px;border-bottom:1px solid var(--c-border);align-items:stretch;box-shadow:var(--shadow-lg)}
        .nav-links.open{display:flex}
        .nav-links a{padding:10px 14px}
        .dropdown-menu{position:static;border:none;background:var(--c-red-lt);margin-left:12px;box-shadow:none}
        .nav-links .btn{margin-left:0;justify-content:center}
    }

    /* ─── PAGES ─── */
    .page { display:none; padding-top:var(--nav-h); min-height:100vh; }
    .page.active { display:block; }

    /* ─── LAYOUT ─── */
    .container { max-width:1100px; margin:0 auto; padding:0 24px; }
    .section { padding:72px 0; }
    .section-sm { padding:48px 0; }

    /* ─── PAGE BANNER (bandeau de titre diagonal, comme l'ancien site) ─── */
    .page-banner {
        margin-top:var(--nav-h); padding:56px 0 84px; position:relative;
        background:linear-gradient(135deg,var(--c-red) 0%,var(--c-red-dk) 100%);
        clip-path:polygon(0 0,100% 0,100% 100%,0 88%);
    }
    .page-banner .hero-eyebrow { color:rgba(255,255,255,.85); }
    .page-banner h1.display { font-size:clamp(1.9rem,4vw,2.6rem); font-weight:900; color:#fff; text-transform:uppercase; letter-spacing:.01em; margin-bottom:12px; }
    .page-banner .lead { color:rgba(255,255,255,.85); }

    /* ─── TYPOGRAPHY ─── */
    .hero-eyebrow { font-size:.72rem; letter-spacing:.2em; text-transform:uppercase; color:var(--c-red); font-weight:600; margin-bottom:14px; }
    h1.display { font-family:'Lato',sans-serif; font-size:clamp(2.2rem,5vw,3.8rem); line-height:1.1; color:var(--c-text); margin-bottom:20px; }
    h2.section-title { font-family:'Lato',sans-serif; font-size:clamp(1.6rem,3vw,2.2rem); color:var(--c-text); margin-bottom:8px; }
    h3 { font-family:'Lato',sans-serif; font-size:1.15rem; color:var(--c-text); margin-bottom:8px; }
    .section-sub { color:var(--c-muted); font-size:.95rem; margin-bottom:40px; }
    .lead { font-size:1.1rem; color:var(--c-brown); line-height:1.75; }

    /* ─── HERO ─── */
    #hero {
        min-height:100vh; display:flex; align-items:center;
        background:linear-gradient(135deg,#fdf1ee 0%,#f7ddd6 100%);
        position:relative; overflow:hidden;
    }
    .hero-img-side {
        position:absolute; right:0; top:0; bottom:0; width:48%;
        background-image:url('https://www.clapsabots.be/wp-content/uploads/2016/10/23_Clapsabots_14_000_Bulgarie-1024x621.jpg');
        background-size:cover; background-position:center;
    }
    .hero-img-side::before { content:''; position:absolute; inset:0; background:linear-gradient(to right,#fdf1ee 0%,rgba(253,241,238,0) 40%); z-index:1; }
    .hero-content { position:relative; z-index:2; max-width:560px; }
    .hero-badge { display:inline-flex; align-items:center; gap:8px; background:var(--c-red-lt); border:1px solid rgba(234,96,69,.2); border-radius:999px; padding:6px 16px; font-size:.72rem; letter-spacing:.15em; text-transform:uppercase; color:var(--c-red); font-weight:600; margin-bottom:20px; }
    .btn { position:relative; z-index:1; display:inline-flex; align-items:center; gap:8px; padding:13px 26px; font-weight:700; font-size:.85rem; letter-spacing:.03em; text-transform:uppercase; text-decoration:none; cursor:pointer; border:none; background:none; transition:transform .2s; font-family:inherit; }
    .btn::before { content:''; position:absolute; z-index:-1; inset:0; transform:skewX(-12deg); transition:background .2s,box-shadow .2s; }
    .btn-primary { color:#fff; }
    .btn-primary::before { background:var(--c-red); box-shadow:0 4px 14px rgba(234,96,69,.3); }
    .btn-primary:hover { transform:translateY(-1px); }
    .btn-primary:hover::before { background:var(--c-red-dk); box-shadow:0 6px 18px rgba(211,26,62,.35); }
    .btn-outline { color:var(--c-red); }
    .btn-outline::before { border:2px solid var(--c-red); }
    .btn-outline:hover { color:#fff; }
    .btn-outline:hover::before { background:var(--c-red); }
    .btn-sm { padding:8px 16px; font-size:.8rem; }
    .hero-actions { display:flex; gap:14px; flex-wrap:wrap; margin-top:32px; }
    .hero-stats { display:flex; gap:36px; margin-top:48px; padding-top:36px; border-top:1px solid var(--c-border); flex-wrap:wrap; }
    .stat-n { font-family:'Lato',sans-serif; font-size:2.2rem; color:var(--c-red); line-height:1; }
    .stat-l { font-size:.72rem; text-transform:uppercase; letter-spacing:.1em; color:var(--c-muted); margin-top:4px; }

    /* ─── CARDS ─── */
    .card { background:var(--c-card); border:1px solid var(--c-border); border-radius:var(--r-lg); overflow:hidden; transition:border-color .2s,box-shadow .2s,transform .2s; box-shadow:var(--shadow); }
    .card:hover { border-color:rgba(234,96,69,.25); box-shadow:var(--shadow-lg); transform:translateY(-3px); }
    .card-img-real { width:100%; height:200px; object-fit:cover; display:block; }
    .card-img-placeholder { width:100%; height:200px; object-fit:cover; display:flex; align-items:center; justify-content:center; background:#eceef1; overflow:hidden; }
    .card-img-placeholder img { width:100%; height:100%; object-fit:cover; }
    .card-body { padding:20px; }
    .card-tag { display:inline-block; background:var(--c-red-lt); color:var(--c-red); font-size:.68rem; font-weight:700; letter-spacing:.1em; text-transform:uppercase; padding:3px 10px; border-radius:99px; margin-bottom:10px; }
    .grid-2 { display:grid; grid-template-columns:repeat(2,1fr); gap:20px; }
    .grid-3 { display:grid; grid-template-columns:repeat(3,1fr); gap:20px; }
    .grid-4 { display:grid; grid-template-columns:repeat(4,1fr); gap:20px; }
    @media(max-width:900px) { .grid-3,.grid-4{grid-template-columns:repeat(2,1fr)} }
    @media(max-width:600px) { .grid-2,.grid-3,.grid-4{grid-template-columns:1fr} }

    /* ─── SECTION CARDS ─── */
    .section-card { position:relative; border-radius:var(--r-lg); overflow:hidden; cursor:pointer; text-decoration:none; display:block; box-shadow:var(--shadow); transition:transform .25s,box-shadow .25s; aspect-ratio:3/2; }
    .section-card:hover { transform:translateY(-4px); box-shadow:var(--shadow-lg); }
    .section-card img { width:100%; height:100%; object-fit:cover; display:block; transition:transform .4s; }
    .section-card:hover img { transform:scale(1.05); }
    .section-card-overlay { position:absolute; inset:0; background:linear-gradient(to top,rgba(28,34,47,.85) 0%,rgba(28,34,47,.1) 55%,transparent 100%); display:flex; flex-direction:column; justify-content:flex-end; padding:20px; }
    .section-card-overlay h4 { color:#fff; font-family:'Lato',sans-serif; font-size:1.1rem; margin-bottom:2px; }
    .section-card-overlay p { color:rgba(255,255,255,.75); font-size:.78rem; }
    .section-strip { display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:16px; }

    /* ─── AGENDA ─── */
    .event-item { display:grid; grid-template-columns:56px 1fr auto; gap:16px; align-items:center; padding:16px; background:var(--c-card); border:1px solid var(--c-border); border-radius:var(--r); margin-bottom:12px; box-shadow:var(--shadow); transition:border-color .2s; }
    .event-item:hover { border-color:rgba(234,96,69,.25); }
    .event-date { text-align:center; }
    .event-day { font-family:'Lato',sans-serif; font-size:1.6rem; color:var(--c-red); line-height:1; }
    .event-month { font-size:.65rem; text-transform:uppercase; letter-spacing:.1em; color:var(--c-muted); }
    .event-title { font-weight:600; color:var(--c-text); margin-bottom:2px; }
    .event-meta { font-size:.8rem; color:var(--c-muted); }
    .event-type { font-size:.68rem; font-weight:700; letter-spacing:.08em; text-transform:uppercase; padding:4px 10px; border-radius:99px; white-space:nowrap; }
    .type-stage { background:#fef3e2; color:#b45309; }
    .type-spectacle { background:var(--c-red-lt); color:var(--c-red); }
    .type-voyage { background:#e0f2fe; color:#0369a1; }
    .type-cours { background:#dcfce7; color:#166534; }

    /* ─── BLOG CARDS WITH IMAGES ─── */
    .blog-card-img { width:100%; height:190px; object-fit:cover; display:block; }
    .blog-card-img-wrap { height:190px; overflow:hidden; background:#eceef1; }
    .blog-card-img-wrap img { width:100%; height:100%; object-fit:cover; transition:transform .4s; }
    .card:hover .blog-card-img-wrap img { transform:scale(1.05); }

    /* ─── BLOG TIMELINE ─── */
    .timeline { position:relative; }
    .timeline-item { display:grid; grid-template-columns:76px 1fr; gap:20px; margin-bottom:28px; position:relative; }
    .timeline-item::before { content:''; position:absolute; left:37px; top:20px; bottom:-28px; width:2px; background:var(--c-border); z-index:0; }
    .timeline-item:last-child::before { display:none; }
    .timeline-marker { display:flex; flex-direction:column; align-items:center; padding-top:2px; }
    .timeline-dot { width:16px; height:16px; border-radius:50%; background:var(--c-red); border:3px solid var(--c-bg); box-shadow:0 0 0 2px var(--c-red); z-index:1; flex-shrink:0; }
    .timeline-date-label { text-align:center; margin-top:10px; }
    .timeline-day { display:block; font-family:'Lato',sans-serif; font-size:2rem; color:var(--c-red); line-height:1; }
    .timeline-month { display:block; font-size:.58rem; text-transform:uppercase; letter-spacing:.07em; color:var(--c-muted); margin-top:4px; line-height:1.5; }
    .timeline-card { background:var(--c-card); border:1px solid var(--c-border); border-radius:var(--r-lg); overflow:hidden; display:grid; grid-template-columns:180px 1fr; box-shadow:var(--shadow); transition:border-color .2s,box-shadow .2s,transform .2s; }
    .timeline-card.no-image { grid-template-columns:1fr; }
    .timeline-card:hover { border-color:rgba(234,96,69,.25); box-shadow:var(--shadow-lg); transform:translateY(-2px); }
    .timeline-card-img { width:180px; height:140px; object-fit:cover; display:block; }
    .timeline-card-body { padding:18px 20px; }
    .timeline-card.no-image .timeline-card-body { padding:20px 24px; }
    @media(max-width:760px){ .timeline-item{grid-template-columns:64px 1fr} .timeline-item::before{left:31px} .timeline-day{font-size:1.6rem} }
    @media(max-width:560px){ .timeline-card{grid-template-columns:1fr} .timeline-card-img{width:100%;height:160px} .timeline-item{grid-template-columns:52px 1fr;gap:12px} .timeline-item::before{left:25px} }

    /* ─── PAGINATION ─── */
    .pagination { display:flex; align-items:center; justify-content:center; gap:8px; margin-top:40px; flex-wrap:wrap; }
    .pagination-btn { padding:8px 14px; border:1.5px solid var(--c-border); border-radius:var(--r); background:#fff; color:var(--c-muted); font-size:.85rem; font-weight:600; cursor:pointer; transition:all .2s; font-family:inherit; }
    .pagination-btn:hover { border-color:var(--c-red); color:var(--c-red); background:var(--c-red-lt); }
    .pagination-btn.active { border-color:var(--c-red); color:var(--c-red); background:var(--c-red-lt); }
    .pagination-btn:disabled { opacity:.4; cursor:not-allowed; pointer-events:none; }

    /* ─── AGENDA REFERENCE CTA ─── */
    .agenda-ref-cta { display:grid; grid-template-columns:auto 1fr auto; gap:40px; align-items:center; background:var(--c-surface); border:1px solid var(--c-border); border-radius:var(--r-lg); padding:36px 40px; box-shadow:var(--shadow-lg); margin-top:-1px; position:relative; top:-1px; }
    .agenda-ref-cta-stats { display:flex; align-items:center; gap:24px; }
    .agenda-ref-stat { display:flex; flex-direction:column; align-items:center; gap:2px; }
    .agenda-ref-stat-num { font-family:'Lato',sans-serif; font-size:2.2rem; font-weight:700; color:var(--c-red); line-height:1; }
    .agenda-ref-stat-label { font-size:.68rem; text-transform:uppercase; letter-spacing:.08em; color:var(--c-muted); white-space:nowrap; }
    .agenda-ref-stat-divider { width:1px; height:40px; background:var(--c-border); }
    .agenda-ref-cta-globe { font-size:4.5rem; opacity:.18; user-select:none; line-height:1; }
    @media(max-width:860px){ .agenda-ref-cta{ grid-template-columns:1fr; gap:24px } .agenda-ref-cta-globe{ display:none } .agenda-ref-cta-stats{ justify-content:flex-start } }

    /* ─── SECTION GALLERY ─── */
    .section-gallery { display:grid; grid-template-columns:repeat(3,1fr); gap:6px; margin-bottom:28px }
    .section-gallery-item { overflow:hidden; border-radius:6px; aspect-ratio:4/3 }
    .section-gallery-item:first-child { grid-column:1/-1; aspect-ratio:16/7; border-radius:var(--r-lg); box-shadow:var(--shadow-lg) }
    .section-gallery-item img { width:100%; height:100%; object-fit:cover; display:block; transition:transform .35s ease }
    .section-gallery-item:hover img { transform:scale(1.04) }
    @media(max-width:600px){ .section-gallery { grid-template-columns:repeat(2,1fr) } .section-gallery-item:first-child { aspect-ratio:16/9 } }

    /* ─── BLOG SHOW ─── */
    .blog-show-hero { margin-top:var(--nav-h); position:relative; height:420px; overflow:hidden; background:#1c222f; }
    .blog-show-hero img { width:100%; height:100%; object-fit:cover; opacity:.55; }
    .blog-show-hero.no-img { background:linear-gradient(135deg,var(--c-brown),var(--c-red-dk)); }
    .blog-show-hero-overlay { position:absolute; inset:0; display:flex; align-items:flex-end; }
    .blog-show-hero-overlay .container { padding-bottom:40px; }
    .blog-content { font-size:.97rem; line-height:1.85; color:var(--c-text); }
    .blog-content p { margin-bottom:1.25em; }
    .blog-content strong { font-weight:600; }
    @media(max-width:600px){ .blog-show-hero{height:280px} .blog-show-hero-overlay .container{padding-bottom:24px} }

    /* ─── TABS ─── */
    .tabs { display:flex; gap:0; border-bottom:2px solid var(--c-border); margin-bottom:32px; overflow-x:auto; }
    .tab { padding:12px 20px; cursor:pointer; font-size:.82rem; font-weight:600; letter-spacing:.04em; text-transform:uppercase; color:var(--c-muted); border-bottom:2px solid transparent; margin-bottom:-2px; transition:all .2s; white-space:nowrap; background:none; border-top:none; border-left:none; border-right:none; font-family:inherit; }
    .tab.active { color:var(--c-red); border-bottom-color:var(--c-red); }
    .tab-panel { display:none; }
    .tab-panel.active { display:block; }

    /* ─── MEMBER SPACE ─── */
    .member-layout { display:flex; margin-top:var(--nav-h); }
    .member-sidebar { width:220px; flex-shrink:0; background:var(--c-surface); border-right:1px solid var(--c-border); padding:24px 0; min-height:calc(100vh - var(--nav-h)); box-shadow:2px 0 8px rgba(28,34,47,.05); }
    .member-main { flex:1; padding:32px 28px; overflow:auto; background:var(--c-bg); min-width:0; }
    .member-page-head { margin-bottom:24px; }
    .member-page-head .hero-eyebrow { margin-bottom:6px; }
    .member-page-head h1 { font-family:'Lato',sans-serif; font-size:clamp(1.4rem,2.6vw,1.9rem); color:var(--c-text); margin-bottom:0; }
    .sidebar-item { display:flex; align-items:center; gap:10px; padding:10px 20px; cursor:pointer; font-size:.85rem; color:var(--c-muted); text-decoration:none; transition:all .2s; border-left:3px solid transparent; }
    .sidebar-item:hover { color:var(--c-text); background:var(--c-red-lt); }
    .sidebar-item.active { color:var(--c-red); border-left-color:var(--c-red); background:var(--c-red-lt); }
    .sidebar-section { padding:16px 20px 6px; font-size:.65rem; text-transform:uppercase; letter-spacing:.15em; color:var(--c-muted); }
    @media(max-width:700px) {
        .member-layout{flex-direction:column}
        .member-sidebar{width:100%;min-height:auto;border-right:none;border-bottom:1px solid var(--c-border);padding:8px 0;display:flex;flex-wrap:wrap}
        .sidebar-item{padding:8px 12px;border-left:none;border-bottom:3px solid transparent}
        .sidebar-item.active{border-left:none;border-bottom-color:var(--c-red)}
        .sidebar-section{display:none}
        .member-main{padding:20px 16px}
    }

    /* ─── FORMULAIRES NATIFS SYMFONY (member area + pages d'authentification) ─── */
    .member-main form, .auth-form { max-width:640px; }
    .member-main form > div, .auth-form > div { margin-bottom:18px; }
    .member-main label, .auth-form label { display:block; font-size:.78rem; font-weight:600; color:var(--c-muted); text-transform:uppercase; letter-spacing:.08em; margin-bottom:7px; }
    .member-main input[type=text], .member-main input[type=email], .member-main input[type=password],
    .member-main input[type=date], .member-main input[type=tel], .member-main input[type=search],
    .member-main select, .member-main textarea,
    .auth-form input[type=text], .auth-form input[type=email], .auth-form input[type=password],
    .auth-form input[type=date], .auth-form input[type=tel], .auth-form input[type=search],
    .auth-form select, .auth-form textarea {
        width:100%; background:#fff; border:1.5px solid var(--c-border); border-radius:var(--r); color:var(--c-text);
        padding:10px 13px; font-size:.9rem; font-family:inherit;
    }
    .member-main input:focus, .member-main select:focus, .member-main textarea:focus,
    .auth-form input:focus, .auth-form select:focus, .auth-form textarea:focus { outline:none; border-color:var(--c-red); box-shadow:0 0 0 3px rgba(234,96,69,.1); }
    .member-main fieldset, .auth-form fieldset { border:none; margin:0 0 8px; padding:0; }
    .member-main fieldset + .gap-20, .member-main .gap-20 { height:20px; }
    .member-main h3.title-border { font-family:'Lato',sans-serif; font-size:1.05rem; font-weight:700; color:var(--c-text); margin-bottom:14px; padding-bottom:8px; border-bottom:1px solid var(--c-border); display:flex; align-items:center; gap:8px; }
