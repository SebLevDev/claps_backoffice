<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Ensemble Clap'Sabots – Danses Traditionnelles{% endblock %}</title>
        <meta name="description" content="{% block meta_description %}Ensemble Clap'Sabots : danse, musique et chant traditionnels à Braine-l'Alleud depuis 1977. Cours pour tous les âges, spectacles, stages et festivals de folklore.{% endblock %}">
        <link rel="canonical" href="{{ app.request.schemeAndHttpHost ~ app.request.pathInfo }}">

        <meta property="og:site_name" content="Ensemble Clap'Sabots">
        <meta property="og:type" content="{% block og_type %}website{% endblock %}">
        <meta property="og:locale" content="fr_BE">
        <meta property="og:title" content="{{ block('title') }}">
        <meta property="og:description" content="{{ block('meta_description') }}">
        <meta property="og:url" content="{{ app.request.schemeAndHttpHost ~ app.request.pathInfo }}">
        <meta property="og:image" content="{% block og_image %}{{ app.request.schemeAndHttpHost }}{{ asset('images/clapsabots/scene-ensemble.jpg') }}{% endblock %}">

        <meta name="twitter:card" content="summary_large_image">
        <meta name="twitter:title" content="{{ block('title') }}">
        <meta name="twitter:description" content="{{ block('meta_description') }}">
        <meta name="twitter:image" content="{{ block('og_image') }}">

        {% block head %}{% endblock %}
        {% block stylesheets %}{% endblock %}
    </head>
    <body id="{% block body_id %}{% endblock %}">
        <div class="body-inner">
            {% block header %}{% endblock %}

            <div class="toast" id="toast"></div>

            <div class="lightbox" id="lightbox" onclick="closeLightbox()">
                <button type="button" class="lightbox-close" onclick="closeLightbox()" aria-label="Fermer">✕</button>
                <img id="lightboxImg" src="" alt="" onclick="event.stopPropagation()">
            </div>

            {% block banner %}{% endblock %}

            {% block container %}{% endblock %}

            {% block footer %}{% endblock %}
        </div>

        {% block javascripts %}{% endblock %}
        <!-- Global site tag (gtag.js) - Google Analytics -->
        <script async src="https://www.googletagmanager.com/gtag/js?id=UA-31061879-2"></script>
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());

            gtag('config', 'UA-31061879-2');
        </script>


        <script>
            // ══════════ UI HELPERS ══════════
            function toggleMenu()       { document.getElementById('navLinks').classList.toggle('open'); }
            function closeMenu()        { document.getElementById('navLinks').classList.remove('open'); }
            function showToast(msg)     { const t=document.getElementById('toast'); t.textContent=msg; t.classList.add('show'); setTimeout(()=>t.classList.remove('show'),2800); }
            function toggleAccordion(h) { h.parentElement.classList.toggle('open'); }
            function openLightbox(src, alt) {
                const img = document.getElementById('lightboxImg');
                img.src = src; img.alt = alt || '';
                document.getElementById('lightbox').classList.add('open');
                document.body.style.overflow = 'hidden';
            }
            function closeLightbox() {
                document.getElementById('lightbox').classList.remove('open');
                document.body.style.overflow = '';
            }
            document.addEventListener('keydown', e => { if (e.key === 'Escape') closeLightbox(); });
            function switchTab(id, btn) {
                const par = btn.closest('.page') || document;
                par.querySelectorAll('.tab').forEach(t=>t.classList.remove('active'));
                par.querySelectorAll('.tab-panel').forEach(p=>p.classList.remove('active'));
                btn.classList.add('active');
                const panel = document.getElementById('tab-'+id);
                if (panel) panel.classList.add('active');
            }
        </script>

    </body>
</html>
