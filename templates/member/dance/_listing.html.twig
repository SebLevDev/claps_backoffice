<div style="overflow-x:auto">
<table class="data-table">
    <thead>
        <tr>
            <th>Nom</th>
            <th>Pays</th>
            <th>Région</th>
            <th>Vidéo</th>
            <th>Stage</th>
        </tr>
    </thead>
    <tbody>
    {% for dance in dances %}
    <tr>
        <td><a href="{{ path('app_dance_show', { 'id': dance.id }) }}">{{ dance.name }}</a></td>
        <td>{{ dance.country|country }}</td>
        <td>{{ dance.region }}</td>
        <td>{% if dance.videosOfPerformance|length > 0 %}🎬{% endif %}</td>
        <td>{% if dance.videosOfWorkShop|length > 0 %}🎬{% endif %}</td>
    </tr>
    {% else %}
    <tr><td colspan="5" class="text-muted">Aucune danse trouvée.</td></tr>
    {% endfor %}
    </tbody>
</table>
</div>
