{% extends 'member/_layout.html.twig' %}

{% block title %}{{ dance.name|e }} – Clap'Sabots{% endblock %}
{% block member_eyebrow %}Danse{% endblock %}
{% block member_title %}{{ dance.name|e }} <span class="text-muted" style="font-size:.6em;font-weight:400">— {{ dance.country|country }}{% if dance.region %} · {{ dance.region }}{% endif %}</span>{% endblock %}

{% block member_main %}
<div class="card mb-32">
    <div class="card-body">
        <p class="text-muted" style="font-size:.9rem;line-height:1.75">{{ dance.description|raw }}</p>
    </div>
</div>

{% if dance.videosOfWorkShop|length > 0 %}
    <h2 class="section-title">Stages</h2>
    {% include 'member/video/_listing.html.twig' with { 'videos': dance.videosOfWorkShop } %}
{% endif %}

{% if dance.videosOfPerformance|length > 0 %}
    <h2 class="section-title mt-24">Vidéos</h2>
    {% include 'member/video/_listing.html.twig' with { 'videos': dance.videosOfPerformance } %}
{% endif %}
{% endblock %}
