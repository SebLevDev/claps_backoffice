{% for piece in pieces %}
    <div class="media-card">
        {% if piece.image is not null %}
            <img src="/uploads/images/clothespieces/{{ piece.image }}" alt="{{ piece.name|e }}">
        {% else %}
            <img src="https://via.placeholder.com/400x600?text=Pas+d%27image" alt="{{ piece.name|e }}">
        {% endif %}
        <div class="media-card-body">
            <h3>{{ piece.name|e }}</h3>
            <span>{{ piece.country|country }}</span>
        </div>
    </div>
{% else %}
    <p class="text-muted">Aucun costume trouvé.</p>
{% endfor %}
