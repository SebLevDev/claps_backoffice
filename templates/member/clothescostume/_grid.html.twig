{% for costume in costumes %}
    {% set costumeImage = null %}
    {% for costumePiece in costume.clothesCostumePieces %}
        {% if costumeImage is null and costumePiece.piece.image is not empty %}
            {% set costumeImage = costumePiece.piece.image %}
        {% endif %}
    {% endfor %}
    <div class="costume-card">
        <div class="costume-thumb">
            {% if costumeImage %}
                <img src="{{ costumeImage }}" alt="{{ costume.name|e }}" style="width:100%;height:100%;object-fit:cover" onerror="this.parentElement.innerHTML='🎽'">
            {% else %}
                🎽
            {% endif %}
        </div>
        <div class="costume-info">
            <h4>{{ costume.name|e }}</h4>
            <p>{{ costume.country|country }}</p>
        </div>
    </div>
{% else %}
    <p class="text-muted">Aucun costume trouvé.</p>
{% endfor %}
