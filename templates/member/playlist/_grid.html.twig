{% for playlist in playlists %}
    <div class="media-card video">
        <img src="https://img.youtube.com/vi/46546/0.jpg" alt="{{ playlist.name|e }}">
        <div class="media-card-body">
            <h3>{{ playlist.name|e }}</h3>
        </div>
    </div>
{% else %}
    <p class="text-muted">Aucune playlist trouvée.</p>
{% endfor %}
