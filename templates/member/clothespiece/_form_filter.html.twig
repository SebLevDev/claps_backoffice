{% set has_filters = app.request.query.all|filter((v, k) => k != 'page' and v is not same as('') and v is not null)|length > 0 %}
<form class="filter-form" action="{{ path('app_clothes_piece_index') }}">
    <div class="filter-search">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <input type="search" name="search" placeholder="Rechercher une pièce…" value="{{ app.request.query.get('search') }}" aria-label="Rechercher une pièce…">
    </div>
    <div class="filter-fields">
        <div class="filter-field">
            <label for="{{ searchClothesPieceform.country.vars.id }}">Pays</label>
            {{ form_widget(searchClothesPieceform.country) }}
        </div>
        <div class="filter-field">
            <label for="{{ searchClothesPieceform.sections.vars.id }}">Section</label>
            {{ form_widget(searchClothesPieceform.sections) }}
        </div>
        <div class="filter-actions">
            {% if has_filters %}<a href="{{ path('app_clothes_piece_index') }}" class="filter-reset">Réinitialiser</a>{% endif %}
            <button type="submit" class="btn btn-primary btn-sm">Rechercher</button>
        </div>
    </div>
</form>
