{% extends 'member/_layout.html.twig' %}

{% block title %}{{ piece.name|e }} – Clap'Sabots{% endblock %}
{% block member_eyebrow %}Pièce de costume{% endblock %}
{% block member_title %}{{ piece.name|e }}{% endblock %}

{% block member_main %}
<div class="grid-2" style="grid-template-columns:1fr 2fr;align-items:start">
    <div class="card" style="overflow:hidden">
        {% if piece.image %}
            <img src="{{ piece.image|e }}" alt="{{ piece.name|e }}" style="width:100%;display:block">
        {% else %}
            <img src="https://via.placeholder.com/400x600?text=Pas+d%27image" alt="{{ piece.name|e }}" style="width:100%;display:block">
        {% endif %}
    </div>

    <div class="card">
        <div class="card-body">
            {% if piece.country is not null %}
                <h3>Pays</h3>
                <p class="text-muted mt-8">{{ piece.country|country }}</p>
            {% endif %}

            {% if piece.sections|length > 0 %}
                <h3 class="mt-24">Section</h3>
                <p class="text-muted mt-8">
                    {% for section in piece.sections %}
                        <a href="{{ path('app_video_search', { 'sections': section.id }) }}">{{ section }}</a>{% if not loop.last %},{% endif %}
                    {% endfor %}
                </p>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
