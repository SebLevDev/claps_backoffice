{% for piece in pieces %}
    <a href="{{ path('app_clothes_piece_show', {'id': piece.id }) }}" class="media-card">
        {% if piece.image %}
            <img src="{{ piece.image|e }}" alt="{{ piece.name|e }}">
        {% else %}
            <img src="https://via.placeholder.com/300x400?text=Pas+d%27image" alt="{{ piece.name|e }}">
        {% endif %}
        <div class="media-card-body">
            <h3>{{ piece.name|e }}</h3>
            <span><img src="/bundles/easyadmin/images/flags/{{ piece.country }}.png" class="country-flag" style="height:13px" alt="">{{ piece.country|country }}</span>
        </div>
    </a>
{% else %}
    <p class="text-muted">Aucune pièce trouvée.</p>
{% endfor %}
