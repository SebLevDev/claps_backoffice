{% extends 'member/_layout.html.twig' %}

{% block title %}{{ 'member.edit_member.title'|trans({'%name%': member.firstname }, 'messages') }} – Clap'Sabots{% endblock %}
{% block member_eyebrow %}Mon compte{% endblock %}
{% block member_title %}{{ 'member.edit_member.title'|trans({'%name%': member.firstname }, 'messages') }}{% endblock %}

{% block member_main %}
{{ form_start(form) }}

<h3 class="title-border">{{ 'member.crud.form.personal'|trans }}</h3>
{{ form_row(form.firstname) }}
{{ form_row(form.lastname) }}
{{ form_row(form.birthdate) }}
{{ form_row(form.sex) }}
{{ form_row(form.niss) }}
{{ form_row(form.insurer) }}

<h3 class="title-border mt-24">{{ 'member.crud.form.contact'|trans }}</h3>
{{ form_row(form.email) }}
{{ form_row(form.phone) }}
{{ form_row(form.mobilePhone) }}

<h3 class="title-border mt-24">{{ 'member.crud.form.address'|trans }}</h3>
{{ form_row(form.address.street) }}
{{ form_row(form.address.streetNumber) }}
{{ form_row(form.address.streetBox) }}
{{ form_row(form.address.zipCode) }}
{{ form_row(form.address.city) }}
{{ form_row(form.address.country) }}

<button type="submit" class="btn btn-primary mt-16">💾 {{ 'action.save'|trans }}</button>
{{ form_end(form) }}
{% endblock %}
