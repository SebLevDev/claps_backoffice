{% extends 'member/_layout.html.twig' %}

{% block title %}Documents – Clap'Sabots{% endblock %}
{% block member_eyebrow %}Vie du club{% endblock %}
{% block member_title %}Documents{% endblock %}

{% block member_main %}
{% for category in categories %}
    <div class="accordion-item {% if loop.first %}open{% endif %}">
        <div class="accordion-header" onclick="toggleAccordion(this)">
            <h4>{{ category.icon ? '📁 ' : '' }}{{ category.name }}</h4>
            <span class="accordion-arrow">▾</span>
        </div>
        <div class="accordion-body">
            {% for document in category.documentFiles %}
                {% if document.document != '' %}
                    <div class="flex-between mb-8">
                        <a href="{{ path_documents ~ '/' ~ document.document }}" target="_blank">{{ document.name }}</a>
                        {% if document.updatedAt != null %}<span class="text-muted" style="font-size:.78rem">{{ document.updatedAt|date('d/m/Y') }}</span>{% endif %}
                    </div>
                {% endif %}
            {% else %}
                <p class="text-muted">Aucun document dans cette catégorie.</p>
            {% endfor %}
        </div>
    </div>
{% else %}
    <p class="text-muted">Aucun document disponible.</p>
{% endfor %}
{% endblock %}
