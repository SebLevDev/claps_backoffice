{% extends 'member/_layout.html.twig' %}

{% block title %}Événements – Clap'Sabots{% endblock %}
{% block member_eyebrow %}Vie du club{% endblock %}
{% block member_title %}Événements{% endblock %}

{% block member_main %}
{% for event in events %}
    <div class="event-item">
        <div class="event-date">
            <div class="event-day">{{ event.date|date('d') }}</div>
            <div class="event-month">{{ event.date|date('M') }}</div>
        </div>
        <div>
            <div class="event-title">{{ event.name }}</div>
            {% if event.venue != '' %}<div class="event-meta">📍 {{ event.venue }}</div>{% endif %}
        </div>
    </div>
{% else %}
    <p class="text-muted">Aucun événement à afficher.</p>
{% endfor %}
{% endblock %}
