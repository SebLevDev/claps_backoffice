{% for video in videos %}
    <a href="{{ path('app_video_show', {'id': video.id }) }}" class="media-card video">
        <img src="https://img.youtube.com/vi/{{ video.youtubeId }}/0.jpg" alt="{{ video.name|e }}">
        <div class="media-card-body">
            <h3>{{ video.name|e }}</h3>
            {% if video.country is not null %}<span>🌍 {{ video.country|country }}</span>{% endif %}
        </div>
    </a>
{% else %}
    <p class="text-muted">Aucune vidéo trouvée.</p>
{% endfor %}
