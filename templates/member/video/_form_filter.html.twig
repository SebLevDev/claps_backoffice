{% set has_filters = app.request.query.all|filter((v, k) => k != 'page' and v is not same as('') and v is not null)|length > 0 %}
<form class="filter-form" action="{{ path('app_video_search') }}">
    <div class="filter-search">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <input type="search" name="search" placeholder="Rechercher une vidéo…" value="{{ app.request.query.get('search') }}" aria-label="Rechercher une vidéo…">
    </div>
    <div class="filter-fields">
        <div class="filter-field">
            <label for="{{ searchVideoform.event.vars.id }}">Événement</label>
            {{ form_widget(searchVideoform.event) }}
        </div>
        <div class="filter-field">
            <label for="{{ searchVideoform.country.vars.id }}">Pays</label>
            {{ form_widget(searchVideoform.country) }}
        </div>
        <div class="filter-field">
            <label for="{{ searchVideoform.sections.vars.id }}">Section</label>
            {{ form_widget(searchVideoform.sections) }}
        </div>
        <div class="filter-field">
            <label for="{{ searchVideoform.tag.vars.id }}">Tags</label>
            {{ form_widget(searchVideoform.tag) }}
        </div>
        <div class="filter-actions">
            {% if has_filters %}<a href="{{ path('app_video_search') }}" class="filter-reset">Réinitialiser</a>{% endif %}
            <button type="submit" class="btn btn-primary btn-sm">Rechercher</button>
        </div>
    </div>
</form>
