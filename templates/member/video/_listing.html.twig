{% for video in videos %}
    <div class="card mb-16" style="display:flex;flex-direction:row;align-items:stretch">
        <a href="{{ path('app_video_show', {'id': video.id }) }}" style="flex-shrink:0;width:220px">
            <img src="https://img.youtube.com/vi/{{ video.youtubeId }}/0.jpg" alt="{{ video.name|e }}" style="width:100%;height:100%;object-fit:cover;display:block">
        </a>
        <div class="card-body">
            <h3><a href="{{ path('app_video_show', {'id': video.id }) }}">{{ video.name|e }}</a></h3>
            <div class="video-meta">
                {% if video.event is not null %}
                    <span>📅 <a href="{{ path('app_video_search', { 'event': video.event.id }) }}">{{ video.event }}</a>{% if video.event.date is not null %} · {{ video.event.date|date('d/m/y') }}{% endif %}</span>
                {% endif %}
                {% if video.country is not null %}
                    <span>🌍 <a href="{{ path('app_video_search', { 'country': video.country }) }}">{{ video.country|country }}</a></span>
                {% endif %}
                {% if video.sections|length > 0 %}
                    <span>👥
                        {% for section in video.sections %}
                            <a href="{{ path('app_video_search', { 'sections': section.id }) }}">{{ section }}</a>{% if not loop.last %},{% endif %}
                        {% endfor %}
                    </span>
                {% endif %}
            </div>
        </div>
    </div>
{% else %}
    <p class="text-muted">Aucune vidéo trouvée.</p>
{% endfor %}
