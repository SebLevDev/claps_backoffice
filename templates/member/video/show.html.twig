{% extends 'member/_layout.html.twig' %}

{% block title %}{{ video.name|e }} – Clap'Sabots{% endblock %}
{% block member_eyebrow %}Vidéo{% endblock %}
{% block member_title %}{{ video.name|e }}{% endblock %}

{% block member_main %}
<div class="grid-2" style="grid-template-columns:2fr 1fr;align-items:start">
    <div class="card" style="overflow:hidden">
        <div style="aspect-ratio:16/9">
            <iframe src="https://www.youtube.com/embed/{{ video.youtubeId }}?rel=0" allowfullscreen style="width:100%;height:100%;border:none;display:block"></iframe>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <h3>Description</h3>
            <p class="text-muted mt-8" style="font-size:.88rem">{{ video.description|raw }}</p>

            {% if video.dances|length > 0 %}
                <h3 class="mt-24">Danses</h3>
                <div class="mt-8" style="display:flex;flex-direction:column;gap:6px">
                    {% for dance in video.dances %}
                        <a href="{{ path('app_dance_show', { 'id': dance.id }) }}">{{ dance }}</a>
                    {% endfor %}
                </div>
            {% endif %}

            {% if video.country is not null %}
                <h3 class="mt-24">Pays</h3>
                <p class="mt-8"><a href="{{ path('app_video_search', { 'country': video.country }) }}">{{ video.country|countryFlag }} {{ video.country|country }}</a></p>
            {% endif %}

            {% if video.event is not null %}
                <h3 class="mt-24">Événement</h3>
                <p class="mt-8"><a href="{{ path('app_video_search', { 'event': video.event.id }) }}">{{ video.event }}</a></p>
            {% endif %}

            {% if video.sections|length > 0 %}
                <h3 class="mt-24">Section</h3>
                <p class="mt-8">
                    {% for section in video.sections %}
                        <a href="{{ path('app_video_search', { 'sections': section.id }) }}">{{ section }}</a>{% if not loop.last %},{% endif %}
                    {% endfor %}
                </p>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
