{% extends 'member/_layout.html.twig' %}

{% block title %}Mon espace – Clap'Sabots{% endblock %}
{% block member_eyebrow %}Bienvenue{% endblock %}
{% block member_title %}Mon espace{% endblock %}

{% block member_main %}
<div class="grid-3 mb-32">
    <a href="{{ path('app_user_show') }}" class="card">
        <div class="card-body text-center">
            <div style="font-size:2.2rem">👤</div>
            <h3 class="mt-8">Mes infos</h3>
            <p class="text-muted mt-8" style="font-size:.85rem">Accède à tes informations personnelles et modifie-les.</p>
        </div>
    </a>
    <a href="{{ path('app_document_index') }}" class="card">
        <div class="card-body text-center">
            <div style="font-size:2.2rem">📄</div>
            <h3 class="mt-8">Documents</h3>
            <p class="text-muted mt-8" style="font-size:.85rem">Tous les documents officiels et pratiques (assurances, PV...)</p>
        </div>
    </a>
    <a href="{{ path('app_dance_index') }}" class="card">
        <div class="card-body text-center">
            <div style="font-size:2.2rem">💃</div>
            <h3 class="mt-8">Danses</h3>
            <p class="text-muted mt-8" style="font-size:.85rem">Le répertoire de danses du groupe.</p>
        </div>
    </a>
    <a href="{{ path('app_video_index') }}" class="card">
        <div class="card-body text-center">
            <div style="font-size:2.2rem">🎬</div>
            <h3 class="mt-8">Vidéos</h3>
            <p class="text-muted mt-8" style="font-size:.85rem">Les vidéos de nos spectacles, stages et apprentissages.</p>
        </div>
    </a>
    <a href="{{ path('app_music_index') }}" class="card">
        <div class="card-body text-center">
            <div style="font-size:2.2rem">🎵</div>
            <h3 class="mt-8">Musiques</h3>
            <p class="text-muted mt-8" style="font-size:.85rem">Les musiques des danses pratiquées.</p>
        </div>
    </a>
    <a href="{{ path('app_clothes_piece_index') }}" class="card">
        <div class="card-body text-center">
            <div style="font-size:2.2rem">✂️</div>
            <h3 class="mt-8">Costumes</h3>
            <p class="text-muted mt-8" style="font-size:.85rem">Les costumes par pays et leurs pièces.</p>
        </div>
    </a>
</div>

<h2 class="section-title">Dernières vidéos</h2>
<a href="{{ path('app_video_index') }}" class="text-muted" style="font-size:.85rem">Toutes les vidéos →</a>
<div class="media-grid mt-16">
    {% include 'member/video/_grid.html.twig' %}
</div>
{% endblock %}
