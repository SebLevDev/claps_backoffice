{% extends 'member/_layout.html.twig' %}

{% block title %}{{ 'user.show_user.title'|trans({'%name%': user.firstname }, 'messages') }} – Clap'Sabots{% endblock %}
{% block member_eyebrow %}Mon compte{% endblock %}
{% block member_title %}Mes informations{% endblock %}

{% block member_main %}
<p class="text-muted mb-24">Accède à tes informations personnelles, modifie-les pour qu'elles soient toujours à jour.</p>

<h3 class="title-border">👤 Mes informations personnelles</h3>
{% for familyMember in familyMembers %}
    <div class="accordion-item {% if loop.first %}open{% endif %}">
        <div class="accordion-header" onclick="toggleAccordion(this)">
            <h4>{{ familyMember.firstname }} {{ familyMember.lastname }}</h4>
            <span class="accordion-arrow">▾</span>
        </div>
        <div class="accordion-body">
            <p>
                🎂 {{ familyMember.birthdate|date('d/m/Y') }}<br>
                ✉️ {{ familyMember.email }}<br>
                📞 <a href="tel:{{ familyMember.mobilePhone }}">{{ familyMember.mobilePhone }}</a><br>
                🏠 {{ familyMember.address }}
            </p>
            <a href="{{ path('app_member_edit', {'id': familyMember.id }) }}" class="btn btn-outline btn-sm mt-16">✏️ Modifier</a>
        </div>
    </div>
{% endfor %}

{% if families is not null and families|length > 0 %}
    <h3 class="title-border mt-32">👪 Ma famille</h3>
    {% for family in families %}
        <div class="accordion-item {% if loop.first %}open{% endif %}">
            <div class="accordion-header" onclick="toggleAccordion(this)">
                <h4>{{ family.lastname }}</h4>
                <span class="accordion-arrow">▾</span>
            </div>
            <div class="accordion-body">
                <p>
                    ✉️ {{ family.fatherEmail }}<br>
                    📞 <a href="tel:{{ family.fatherMobilePhone }}">{{ family.fatherMobilePhone }}</a><br><br>
                    ✉️ {{ family.motherEmail }}<br>
                    📞 <a href="tel:{{ family.motherMobilePhone }}">{{ family.motherMobilePhone }}</a>
                </p>
                <a href="{{ path('app_member_edit', {'id': family.id }) }}" class="btn btn-outline btn-sm mt-16">✏️ Modifier</a>
            </div>
        </div>
    {% endfor %}
{% endif %}

<h3 class="title-border mt-32">🏷️ Mes affiliations</h3>
{% for familyMember in familyMembers %}
    <div class="accordion-item {% if loop.first %}open{% endif %}">
        <div class="accordion-header" onclick="toggleAccordion(this)">
            <h4>{{ familyMember.firstname }} {{ familyMember.lastname }}</h4>
            <span class="accordion-arrow">▾</span>
        </div>
        <div class="accordion-body">
            <div style="overflow-x:auto">
            <table class="data-table">
                {% for memberShip in familyMember.memberShips|reverse %}
                    <tr>
                        <td>{{ memberShip.clubYear.club.name }}</td>
                        <td>{{ memberShip.startDate|date('d/m/Y') }}</td>
                        <td>
                            {% for section in memberShip.sections %}
                                <span class="badge badge-blue">{{ section.name }}</span>
                            {% endfor %}
                        </td>
                        <td>{{ memberShip.subscriptionAmount }} €</td>
                        <td>
                            {% if memberShip.isPaid %}
                                <span class="badge badge-green">✅ Payé</span> <small class="text-muted">{{ memberShip.subscriptionPaidAt|date('d/m/Y', false) }}</small>
                            {% else %}
                                <span class="badge badge-red">❌ Non payé</span>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </table>
            </div>
        </div>
    </div>
{% endfor %}
{% endblock %}
