{% extends 'old/layout_rightcolumn.html.twig' %}

{% block body_id 'user_password' %}

{% block main %}
    <h1>{{ 'user.change_password.title'|trans }}</h1>

    <div class="alert alert-info" role="alert">{{ 'user.change_password.info'|trans }}</div>

    {{ form_start(form) }}
    {{ form_widget(form) }}

    <button type="submit" class="btn btn-primary">
        <i class="fa fa-save" aria-hidden="true"></i> {{ 'action.save'|trans }}
    </button>
    {{ form_end(form) }}
{% endblock %}

{% block sidebar %}
    <div class="section widget widget-user">
        <a href="{{ path('user_edit') }}" class="btn btn-lg btn-block btn-danger">
            <i class="fa fa-edit" aria-hidden="true"></i> {{ 'user.edit_user.action'|trans }}
        </a>
    </div>

    {{ parent() }}
{% endblock %}
